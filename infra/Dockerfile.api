# API de control. Instala desde el lock; sin dependencias de desarrollo.
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159

ENV UV_NO_CACHE=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app/backend UV_PROJECT_ENVIRONMENT=/opt/venv PATH=/opt/venv/bin:$PATH
RUN pip install --no-cache-dir "uv==0.13.6"

WORKDIR /app/backend
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY backend/alembic ./alembic
COPY backend/wallba ./wallba

RUN useradd --uid 10001 --no-create-home wallba \
    && mkdir -p /data && chown wallba /data
USER wallba
VOLUME /data

CMD ["uvicorn", "--factory", "wallba.foundation.app:create_app_from_env", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
